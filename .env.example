# Google Gemini is the only AI provider used by Creative OS.
# Never commit a real API key.
GEMINI_API_KEY=

# Text model roles.
GEMINI_CAMPAIGN_MODEL=gemini-3.5-flash-lite
GEMINI_CREATIVE_MODEL=gemini-3.6-flash
GEMINI_ADVANCED_FLASH_MODEL=gemini-3.7-flash
GEMINI_REVIEW_MODEL=gemini-3.1-pro-preview

# Image model roles.
GEMINI_IMAGE_DRAFT_MODEL=gemini-3.1-flash-lite-image
GEMINI_IMAGE_PRODUCTION_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_PREMIUM_MODEL=gemini-3-pro-image
GEMINI_IMAGE_RESOLUTION=1K

# Audio.
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Video model roles.
GEMINI_VIDEO_LITE_MODEL=veo-3.1-lite-generate-preview
GEMINI_VIDEO_FAST_MODEL=veo-3.1-fast-generate-preview
GEMINI_VIDEO_PREMIUM_MODEL=veo-3.1-generate-preview

# Paid media is opt-in even on a billed Gemini project.
# Set true only when a command is intentionally allowed to spend on image/video generation.
ALLOW_PAID_MEDIA=false

# Optional: use an existing local image and skip image generation entirely.
POSTER_BASE_IMAGE_PATH=

# Optional: override the Chrome/Chromium executable used for deterministic PNG rendering.
CHROME_PATH=
