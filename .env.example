# Campaign provider selection: openrouter | groq | openai
# If omitted, the router prefers OPENROUTER_API_KEY when present, then GROQ_API_KEY, then OPENAI_API_KEY.
AI_CAMPAIGN_PROVIDER=openrouter

# OpenRouter no-card/free-model development
OPENROUTER_API_KEY=
# Simplest: automatically route among currently available free text models.
OPENROUTER_CAMPAIGN_MODEL=openrouter/free
# For more reproducible testing, you can instead use a specific free model such as:
# OPENROUTER_CAMPAIGN_MODEL=openai/gpt-oss-20b:free

# Groq free-tier development
GROQ_API_KEY=
GROQ_CAMPAIGN_MODEL=openai/gpt-oss-120b

# OpenAI production/paid path
OPENAI_API_KEY=
OPENAI_CAMPAIGN_MODEL=gpt-5.6-luna

# Poster image draft provider
# getimg.ai image generation is pay-per-request; choose model explicitly.
GETIMG_API_KEY=
GETIMG_IMAGE_MODEL=gemini-3-1-flash-lite-image
GETIMG_IMAGE_RESOLUTION=1K

# Optional: use an existing local image instead of calling getimg.ai.
POSTER_BASE_IMAGE_PATH=

# Optional: override the Chrome/Chromium executable used for deterministic PNG rendering.
CHROME_PATH=
