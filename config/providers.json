{
  "version": 3,
  "provider": "google-gemini",
  "billing": {
    "tier": "paid",
    "paidMediaOptInEnvironment": "ALLOW_PAID_MEDIA",
    "pricingReferenceDate": "2026-08-13"
  },
  "roles": {
    "campaignDefault": {
      "model": "gemini-3.5-flash-lite",
      "status": "active"
    },
    "creativeDirector": {
      "model": "gemini-3.6-flash",
      "status": "active"
    },
    "advancedFlash": {
      "model": "gemini-3.7-flash",
      "status": "active",
      "useWhen": [
        "advanced-reasoning",
        "higher-quality-flash-output"
      ]
    },
    "independentReview": {
      "model": "gemini-3.1-pro-preview",
      "status": "active",
      "useWhen": [
        "sensitive",
        "major-campaign",
        "high-reputation-risk"
      ]
    },
    "draftImage": {
      "model": "gemini-3.1-flash-lite-image",
      "status": "active-paid"
    },
    "productionImage": {
      "model": "gemini-3.1-flash-image",
      "status": "active-paid"
    },
    "premiumImage": {
      "model": "gemini-3-pro-image",
      "status": "active-paid"
    },
    "tts": {
      "model": "gemini-3.1-flash-tts-preview",
      "status": "active"
    },
    "routineVideo": {
      "model": "veo-3.1-lite-generate-preview",
      "status": "active-paid"
    },
    "fastVideo": {
      "model": "veo-3.1-fast-generate-preview",
      "status": "active-paid"
    },
    "premiumVideo": {
      "model": "veo-3.1-generate-preview",
      "status": "active-paid"
    }
  },
  "policy": {
    "singleProviderFamily": true,
    "premiumDuringBrainstorming": false,
    "productionImageRequiresApprovedConcept": true,
    "videoRequiresApprovedStaticDirection": true,
    "premiumMediaRequiresExplicitOverride": true,
    "costEstimateWhenPractical": true,
    "paidMediaRequiresRuntimeOptIn": true
  }
}
