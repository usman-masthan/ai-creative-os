{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-creative-os.local/schemas/creative-brief.schema.json",
  "title": "CreativeBrief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "clientId", "brandId", "goal", "description", "audience", "vibe", "format", "contentRequirements", "brandKitId", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "clientId": { "type": "string", "minLength": 1 },
    "brandId": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      },
      "anyOf": [{ "required": ["id"] }, { "required": ["name"] }]
    },
    "branchId": { "type": "string", "minLength": 1 },
    "salesChannel": { "type": "string", "minLength": 1 },
    "audience": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "vibe": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "width", "height"],
      "properties": {
        "preset": { "enum": ["instagram-square", "instagram-portrait", "instagram-story", "facebook-post", "facebook-story", "digital-menu", "web-banner", "poster", "custom"] },
        "width": { "type": "integer", "minimum": 64, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 64, "maximum": 16384 }
      }
    },
    "contentRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["showPrice", "showOffer", "showCTA", "showProductName", "showBranch", "showContactDetails", "showCampaignDates"],
      "properties": {
        "showPrice": { "type": "boolean" },
        "showOffer": { "type": "boolean" },
        "showCTA": { "type": "boolean" },
        "showProductName": { "type": "boolean" },
        "showBranch": { "type": "boolean" },
        "showContactDetails": { "type": "boolean" },
        "showCampaignDates": { "type": "boolean" },
        "headlineDirection": { "type": "string", "minLength": 1 },
        "customInstructions": { "type": "string", "minLength": 1 }
      }
    },
    "brandKitId": { "type": "string", "minLength": 1 },
    "truthSnapshotId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
